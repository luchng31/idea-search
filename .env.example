# idea-search 配置示例 — 复制为 .env 并填写
# 复制方式: cp .env.example .env

# LLM API 密钥(二选一,DeepSeek 优先)。用于:把想法翻译成搜索策略、评审项目匹配度
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# LLM 服务地址与模型(默认 DeepSeek,兼容任何 OpenAI 协议的服务)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# GitHub Token(可选)。不填也能搜,但限流更严格(未认证 10 次/分钟)
# 获取: https://github.com/settings/tokens (勾选 public_repo 或什么都不勾也行,搜索只需读权限)
GITHUB_TOKEN=